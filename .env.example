# Firebase — copy this file to .env and fill in your values.
# Add these same variables to your Vercel project settings (Settings → Environment Variables).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# KnobzToLearn certificate catalogue (live). Use KnobzToLearn's Supabase URL and
# public anon key. Leave blank to show the built-in certificate list.
VITE_KNOBZ_SUPABASE_URL=
VITE_KNOBZ_SUPABASE_ANON_KEY=

# AI writing (career personalisation, CV and LinkedIn) via Groq. Server-side only:
# no VITE_ prefix, so it never reaches the browser. Optional GROQ_MODEL override.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
