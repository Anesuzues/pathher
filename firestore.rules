rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isRecruiter() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isRecruiter', false) == true;
    }

    // User profiles — only the owning user can read or write their own document.
    // isRecruiter is granted by the PathHer team (Firebase console / Admin SDK),
    // so a user can never set or change it on their own document.
    match /users/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
                    && !('isRecruiter' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isRecruiter']);
    }

    // Mentor requests — authenticated users can create their own pending requests;
    // only the request owner can read or delete. Matching (status changes) is done
    // by the PathHer team, not by the requester.
    match /mentorRequests/{requestId} {
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read, delete: if signedIn()
                          && resource.data.userId == request.auth.uid;
    }

    // Roles — only verified recruiters can post, and only as themselves;
    // any authenticated user can read roles (talent discovery);
    // only the poster can update or delete, and cannot reassign ownership.
    match /roles/{roleId} {
      allow create: if isRecruiter()
                    && request.resource.data.postedBy == request.auth.uid;
      allow read: if signedIn();
      allow update: if signedIn()
                    && resource.data.postedBy == request.auth.uid
                    && request.resource.data.postedBy == resource.data.postedBy;
      allow delete: if signedIn()
                    && resource.data.postedBy == request.auth.uid;
    }
  }
}
